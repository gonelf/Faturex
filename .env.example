# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# RSA Private Key for Digital Signatures (Portaria n.º 363/2010)
# Generate with: openssl genrsa -out private_key.pem 1024
# Then convert to single line: awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private_key.pem
RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# Application Settings
PORT=3000
NODE_ENV=development

# Company Information (for QR Code generation)
COMPANY_NIF=123456789
COMPANY_NAME=Your Company Name

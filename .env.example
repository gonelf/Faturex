# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# RSA Private Key for Digital Signatures (Portaria n.º 363/2010)
# Generate with: openssl genrsa -out private_key.pem 1024
# Then convert to single line: awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private_key.pem
RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# Encryption Key for AT Credentials (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This key is used to encrypt AT Portal das Finanças credentials in the database
ENCRYPTION_KEY=your_64_character_hex_key_here

# Application Settings
PORT=3000
NODE_ENV=development

# Company Information (for QR Code generation)
COMPANY_NIF=123456789
COMPANY_NAME=Your Company Name

# Email Notifications (for contact leads)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# IMPORTANT: Email addresses must be RFC 5322 compliant
# EMAIL_FROM format: "Name <email@domain.com>" or just "email@domain.com"
# Examples:
#   - Faturex <noreply@yourdomain.com>  (with display name)
#   - noreply@yourdomain.com            (without display name)
EMAIL_FROM=Faturex <noreply@yourdomain.com>

# Email address where lead notifications will be sent
# Must be a valid email address
# Examples:
#   - admin@yourdomain.com
#   - leads@yourcompany.com
LEAD_NOTIFICATION_EMAIL=your-email@yourdomain.com

# ============================================================================
# AT (Autoridade Tributária) Integration - Phase 2
# SOAP Webservice Configuration
# ============================================================================

# AT Environment (development or production)
# - development: Uses test/homologation endpoint (port 722)
# - production: Uses production endpoint (port 723)
AT_ENVIRONMENT=development

# AT WSDL URLs
# Production endpoint (verified)
AT_WSDL_URL_PRODUCTION=https://servicos.portaldasfinancas.gov.pt:723/fatcorews/ws?wsdl

# Homologation/Test endpoint
# Note: Contact asi-psws@at.gov.pt for test certificate and credentials
AT_WSDL_URL_HOMOLOG=https://servicos.portaldasfinancas.gov.pt:722/fatcorews/ws?wsdl

# Mock Validation (for development without AT access)
# Set to 'true' to use mock validation instead of real SOAP calls
# Set to 'false' for production to use real AT webservice
AT_USE_MOCK_VALIDATION=true

# Digital Certificate (optional, for production)
# Path to .pfx or .pem certificate file
# Required for production AT submissions
# Obtain from: asi-psws@at.gov.pt (test) or certified provider (production)
# AT_CERTIFICATE_PATH=/path/to/certificate.pfx
# AT_CERTIFICATE_PASSWORD=certificate_password_here
